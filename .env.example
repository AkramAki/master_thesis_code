# Local settings. Relative paths start at the repository root.
MOJAVE_FITS_DIR=data/intensities_fits
MOJAVE_UV_DIR=data/uv-files
# Processed datasets: MOJAVE_DATA_ROOT/Mojave_I_<image_size>.
MOJAVE_DATA_ROOT=data
# Training runs, including model checkpoints, samples, and CSV logs.
OUTPUT_ROOT=outputs
MOJAVE_PREPROCESS_CPUS=1

# TorchInductor compilation worker limit.
TORCHINDUCTOR_COMPILE_THREADS=1

# Server settings (alternative values).
# MOJAVE_FITS_DIR=/cephfs/projects/RADIO/mojave_archive/intensities_fits
# MOJAVE_UV_DIR=/cephfs/projects/RADIO/mojave_archive/uv-files
# MOJAVE_DATA_ROOT=/cephfs/users/aaki/data
# OUTPUT_ROOT=/cephfs/users/aaki/radio_diffusion_models
# MOJAVE_PREPROCESS_CPUS=40

# Raw-data sources for scripts/sync_examples.py.
MOJAVE_REMOTE_FITS=nuradio:/cephfs/projects/RADIO/mojave_archive/intensities_fits
MOJAVE_REMOTE_UV=nuradio:/cephfs/projects/RADIO/mojave_archive/uv-files
